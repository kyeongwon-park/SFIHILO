{
  "description": "Small nonstationarity check using the same three comparison groups as the full nonstationarity experiment.",
  "d_list": [2],
  "n_runs": 1,
  "methods": [
    {
      "key": "unweighted_recency",
      "base": "boundary_lookahead",
      "label": "Boundary Lookahead (Unweighted)",
      "forward_weight_mode": "none"
    },
    {
      "key": "estimated_recency",
      "base": "boundary_lookahead",
      "label": "Boundary Lookahead (Estimated Recency)",
      "forward_weight_mode": "estimated_recency"
    },
    {
      "key": "oracle_recency",
      "base": "boundary_lookahead",
      "label": "Boundary Lookahead (Oracle Recency)",
      "forward_weight_mode": "oracle_recency"
    }
  ],
  "reward_model": "gp",
  "noise": {
    "control_jitter_std": 0.02,
    "oracle_phi_noise_std": 0.05,
    "reward_noise_std": 0.02
  },
  "qc_list": [1, 2],
  "tau_list": [0.02, 0.04, 0.08, 0.16],
  "target_kept": 24,
  "balanced_test_total": 24,
  "test_pool_size": 300,
  "test_pool_batch": 128,
  "candidate_pool_size": 64,
  "n_test_rmse": 64,
  "n_use_eval": 24,
  "policy_eval_pool_size": 128,
  "policy_eval_batch": 64,
  "policy_mc_forward_samples": 2,
  "seed_base": 1000,
  "n_jobs": 1,
  "torch_num_threads": 1,
  "N_CAL_X": 256,
  "N_CAL_PHI": 256,
  "GP_PHI_RFF_M": 64,
  "GP_R_RFF_M": 64,
  "INVERSE_GP_RFF_M": 32,
  "INVERSE_GP_MAP_LBFGS_ITERS": 12,
  "INVERSE_GP_POST_SAMPLES": 32,
  "BOUNDARY_LOOKAHEAD_TARGET_TOPK": 6,
  "BOUNDARY_LOOKAHEAD_TARGET_FORWARD_SAMPLES": 1,
  "BOUNDARY_LOOKAHEAD_SHORTLIST_KEEP": 3,
  "BOUNDARY_LOOKAHEAD_SHORTLIST_POOL_SOFT_EXTRA": 1,
  "BOUNDARY_LOOKAHEAD_SHORTLIST_POOL_VARIANCE_EXTRA": 1,
  "BOUNDARY_LOOKAHEAD_SHORTLIST_POOL_RANDOM_EXTRA": 1,
  "FORWARD_FULLKRR_TUNE_MAX_POINTS": 64,
  "FORWARD_FULLKRR_WARMUP_SAMPLES": 4,
  "FORWARD_TPE_SCHEDULE_N_TRIALS": 4,
  "FORWARD_TPE_SCHEDULE_STARTUP_TRIALS": 2,
  "FORWARD_TPE_SCHEDULE_TAU_RANGE": [5.0, 50.0],
  "FORWARD_TPE_SCHEDULE_H_RANGE": [0.02, 0.40],
  "drift": {
    "enabled": true,
    "q95_queries": 2.0,
    "target_alpha": 0.95,
    "eval_pair_bank": 300,
    "eval_forward_bank": 64,
    "forward_alpha_weight_bandwidth": 0.15,
    "forward_alpha_weight_floor": 0.0001
  },
  "metrics": {
    "enable_noncore": false,
    "extra_pref_stats": false,
    "gp_diagnostics": false,
    "shortlist_source_logging": false,
    "query_diversity": false,
    "target_query_metric": false
  }
}
